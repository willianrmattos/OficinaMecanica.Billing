{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Issuer": "OficinaMecanica.Seguranca",
    "Audience": "OficinaMecanica.Client",
    "JwksUri": "https://apimfiap.azure-api.net/segurancaserver/.well-known/jwks.json"
  },
  "Pagamento": {
    "Provider": "MercadoPago"
  },
  "MercadoPago": {
    "TimeoutSegundos": 10,
    "ToleranciaDaAssinaturaSegundos": 300
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "Mensageria": {
    "Transporte": "RabbitMq",
    "Persistencia": "EntityFramework",
    "RetryIntervalosMs": [ 500, 2000, 10000, 30000, 60000 ],
    "OutboxQueryDelayMs": 1000,
    "TimeoutDeInicioSegundos": 60
  },
  "Billing": {
    "ReconciliadorHabilitado": true,
    "ReconciliadorIntervaloSegundos": 300,
    "ReconciliadorTamanhoDoLote": 50,
    "ReconciliadorMaximoDeTentativasDeEstorno": 10
  },
  "Otel": {
    "Endpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "MassTransit": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
