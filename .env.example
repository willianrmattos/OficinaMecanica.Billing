# Copie para .env (ignorado pelo git) e preencha. Nenhum valor real entra no repositorio.

# SQL Server local do compose (usuario sa). Senha forte: 8+ caracteres com maiuscula, minuscula, numero e simbolo.
MSSQL_SA_PASSWORD=<senha-forte-do-sql-server-local>

# RabbitMQ: em modo standalone o compose cria este usuario; sem standalone, use as credenciais do broker do
# compose do OficinaMecanica (que o Billing alcanca por host.docker.internal).
RABBITMQ_USER=<usuario-do-rabbitmq-local>
RABBITMQ_PASSWORD=<senha-do-rabbitmq-local>

# Segredo com que o gateway Fake assina os webhooks que ele mesmo dispara (so desenvolvimento).
FAKE_WEBHOOK_SECRET=<segredo-qualquer-do-gateway-fake>

# Mercado Pago REAL (so com Pagamento__Provider=MercadoPago, fora do compose de desenvolvimento).
# Em producao vem do Key Vault; aqui ficam so para testes manuais com credenciais de teste do Mercado Pago.
MERCADOPAGO_ACCESS_TOKEN=<access-token-de-teste-do-mercado-pago>
MERCADOPAGO_WEBHOOK_SECRET=<segredo-do-webhook-do-mercado-pago>
MERCADOPAGO_NOTIFICATION_BASE_URL=<url-publica-do-billing-ex-https://apimfiap.azure-api.net/billingserver>

# Opcionais (os valores abaixo sao os padroes do compose).
# BILLING_CONTAINER_PREFIX=oficinamecanica-billing
# BILLING_API_HOST_PORT=5001
# BILLING_SQL_HOST_PORT=1435
# BILLING_RABBIT_HOST_PORT=5673
# BILLING_RABBIT_MGMT_HOST_PORT=15673
# RABBITMQ_HOST=host.docker.internal   (use "rabbitmq" com --profile standalone)
# RABBITMQ_PORT=5672                   (a porta DENTRO da rede do compose ou a do host do broker externo)
